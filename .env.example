# Authoritative environment list for Friction-Free Marketplace.
# Copy to apps/web/.env.local. Values below are placeholders, not secrets.
# Required means the production server refuses to boot without a real value.
# Optional means the feature degrades when the value is absent.

# Required. Production: https://frictionfree.co
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPPORT_EMAIL=support@example.com

# Optional application identity
NEXT_PUBLIC_APP_NAME=Friction-Free Marketplace

# Social sign-in buttons on /login and /signup (comma list: google,apple).
# Each provider must also be enabled in Supabase > Authentication > Providers (docs/HANDOVER.md §3).
# Until it is, the button shows "Google sign-in isn't connected yet" instead of failing.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# Optional. Connect webhook endpoint is /api/stripe/connect/webhook.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional integrations. Leave unset to disable the feature.
OPENAI_API_KEY=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional scheduled-route bearer secrets. Routes return 503 until one is set.
# Railway cron services send Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
SEARCH_SYNC_SECRET=
SCHEDULED_JOB_SECRET=
ADMIN_WORKER_SECRET=

# Optional. Local UI bypass. Must stay unset on every hosted environment.
ALLOW_DEV_AUTH_BYPASS=

# Optional. Set true only for local sample data. Ignored unless NODE_ENV is development or test.
MARKETPLACE_DEMO_MODE=

# Optional. Marketplace MCP at /api/mcp. Enabled by default; set to 0 to disable.
# Read-only public tools only. No payment actions.
FFM_MCP_ENABLED=

# Optional Playwright. FFM_E2E_AUTH is local-only and never enables a shared user.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001
PLAYWRIGHT_SKIP_WEB_SERVER=
FFM_E2E_AUTH=
