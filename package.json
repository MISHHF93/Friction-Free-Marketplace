{
  "name": "friction-free-marketplace",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run web:test",
    "test:unit": "npm run web:test:unit",
    "test:e2e": "npm run web:test:e2e",
    "shared:build": "npm --workspace @ffm/shared run build",
    "shared:typecheck": "npm --workspace @ffm/shared run typecheck",
    "web:dev": "npm --workspace apps/web run dev",
    "web:start": "npm --workspace apps/web run start",
    "web:build": "npm --workspace apps/web run build",
    "web:lint": "npm --workspace apps/web run lint",
    "web:typecheck": "npm --workspace apps/web run typecheck",
    "web:test": "npm --workspace apps/web run test",
    "web:test:unit": "npm --workspace apps/web run test:unit",
    "web:test:e2e": "npm --workspace apps/web run test:e2e",
    "web:search:index": "npm --workspace apps/web run search:index",
    "platform:verify": "node scripts/verify-platforms.mjs",
    "platform:build": "npm run platform:verify && npm run shared:build && npm run web:build",
    "text:check": "node scripts/check-text-encoding.mjs",
    "security:audit": "node scripts/check-production-audit.mjs",
    "database:verify": "node scripts/guard-legacy-migrations.mjs && node scripts/verify-migrations.mjs",
    "security:api": "node scripts/verify-api-security.mjs",
    "release:check": "npm run platform:verify && npm run text:check && npm run security:audit && npm run security:api && npm run database:verify && npm run shared:typecheck && npm run web:lint && npm run web:typecheck && npm run web:test && npm run web:build && node scripts/scan-artifact-secrets.mjs apps/web/.next/static",
    "production:smoke": "node scripts/production-smoke.mjs",
    "qa:crawl": "node scripts/qa-crawl.mjs"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
