{
  "name": "friction-free-marketplace",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run web:test",
    "test:unit": "npm run web:test:unit",
    "test:e2e": "npm run web:test:e2e",
    "shared:build": "npm --workspace @ffm/shared run build",
    "shared:typecheck": "npm --workspace @ffm/shared run typecheck",
    "web:dev": "npm --workspace apps/web run dev",
    "web:start": "npm --workspace apps/web run start",
    "web:build": "npm --workspace apps/web run build",
    "web:lint": "npm --workspace apps/web run lint",
    "web:typecheck": "npm --workspace apps/web run typecheck",
    "web:test": "npm --workspace apps/web run test",
    "web:test:unit": "npm --workspace apps/web run test:unit",
    "web:test:e2e": "npm --workspace apps/web run test:e2e",
    "web:search:index": "npm --workspace apps/web run search:index",
    "mobile:sync": "npm --workspace @ffm/mobile run sync",
    "mobile:android": "npm --workspace @ffm/mobile run open:android",
    "mobile:ios": "npm --workspace @ffm/mobile run open:ios",
    "mobile:doctor": "npm --workspace @ffm/mobile run doctor",
    "text:check": "node scripts/check-text-encoding.mjs",
    "release:check": "npm run text:check && npm run shared:typecheck && npm run web:lint && npm run web:typecheck && npm run web:test && npm run web:build && npm --workspace @ffm/mobile run build",
    "production:smoke": "node scripts/production-smoke.mjs"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
