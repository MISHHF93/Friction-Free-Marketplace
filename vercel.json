{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run web:build",
  "regions": ["yul1"],
  "crons": [
    {
      "path": "/api/notifications/dispatch",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/offers/expire",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/search/sync",
      "schedule": "30 * * * *"
    }
  ]
}
