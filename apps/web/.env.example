# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Friction-Free Marketplace"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Search discovery (Meilisearch)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey
SEARCH_SYNC_SECRET=replace-with-cron-secret

# Email (Resend)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL="Friction-Free Marketplace <hello@example.com>"

# Product analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_public_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_KEY=phc_your_server_key
POSTHOG_HOST=https://app.posthog.com

# E2E tests
