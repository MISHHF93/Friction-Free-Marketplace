# Application (required)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="Friction-Free Marketplace"
MARKETPLACE_DEMO_MODE=false
APPLE_TEAM_ID=your-10-character-apple-team-id
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# OpenAI (optional; deterministic search and assistant fallback remain available)
OPENAI_API_KEY=sk-your-openai-key

# Search discovery / Meilisearch (optional; database search remains available)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey

# Search sync jobs (optional, recommended for production cron/webhook calls)
SEARCH_SYNC_SECRET=replace-with-cron-secret
ADMIN_WORKER_SECRET=replace-with-admin-worker-secret
SCHEDULED_JOB_SECRET=replace-with-scheduled-job-secret

# Email / Resend (optional until transactional email is enabled)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL="Friction-Free Marketplace <hello@example.com>"
SUPPORT_EMAIL=support@example.com

# Product analytics / PostHog (optional, recommended for production)
POSTHOG_KEY=phc_your_server_key
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_public_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# E2E tests (optional)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001
PLAYWRIGHT_SKIP_WEB_SERVER=
