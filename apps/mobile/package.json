{
  "name": "@ffm/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "sync": "npm run build && cap sync",
    "doctor": "cap doctor",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "validate:release": "node scripts/validate-release.mjs",
    "build:android": "npm run validate:release && npm run sync && cd android && ./gradlew bundleRelease",
    "build:ios": "npm run validate:release && npm run sync && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -sdk iphoneos CODE_SIGNING_ALLOWED=NO archive -archivePath build/App.xcarchive"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/network": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.7.2"
  }
}
