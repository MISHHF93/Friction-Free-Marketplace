# GitHub Actions configuration for the release workflow (.github/workflows/release-web.yml).
# Copy to .env.handover.local (gitignored), fill in, then run:
#   node scripts/handover/apply-github-config.mjs <owner/repo>

# ---- Variables (not secret) ----
PRODUCTION_APP_URL=https://www.frictionfree.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_OAUTH_PROVIDERS=google
# Switch to support@frictionfree.co once that mailbox exists and the domain is verified in Resend.
SUPPORT_EMAIL=garfieldgarwood45@gmail.com

# ---- Container build + release evidence secrets ----
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
