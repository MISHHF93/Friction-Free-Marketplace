# GitHub Actions configuration for the release workflows (.github/workflows/release-*.yml).
# Copy to .env.handover.local (gitignored), fill in, then run:
#   node scripts/handover/apply-github-config.mjs <owner/repo>
# Empty lines are skipped, so mobile-store values can wait until the store accounts exist.

# ---- Variables (not secret) ----
PRODUCTION_APP_URL=https://frictionfree.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_OAUTH_PROVIDERS=google
SUPPORT_EMAIL=

# ---- Web build + deploy secrets ----
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---- Native app association (web) + store release ----
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Multi-line values do not fit this file. Set them straight from the downloaded file:
#   gh secret set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON --repo <owner/repo> < play-service-account.json
#   gh secret set APP_STORE_CONNECT_API_PRIVATE_KEY --repo <owner/repo> < AuthKey_XXXX.p8
